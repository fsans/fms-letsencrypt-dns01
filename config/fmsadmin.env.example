# FMS Admin Console credentials for the certbot deploy hook.
# Install:  /etc/letsencrypt/.secrets/fmsadmin.env   (root-only, chmod 600)
# If the admin password is ever rotated, update this file — otherwise
# every renewal fails at the fmsadmin import step.
FMSADMIN_USER=admin
FMSADMIN_PASS=YOUR_ADMIN_CONSOLE_PASSWORD
