# Config for check-cert-and-report.sh — install at /etc/fms-cert-check.env
# (chmod 600 if it contains SMTP credentials; only root/launchd reads it).

DOMAIN=fms.example.com            # cert CN/SAN to verify
CONNECT_HOST=localhost            # run on the FMS machine
WARN_DAYS=30                      # warn when fewer days remain than this

# Email report (curl over SMTPS — no local MTA needed)
ADMIN_EMAIL=admin@example.com     # report recipient
EMAIL_FROM=noreply@example.com    # sender
SMTP_USER=                        # leave empty if relay needs no auth
SMTP_PASS=
SMTP_URL=smtps://smtp.example.com:465   # or smtp://smtp.example.com:587 (STARTTLS)

# Send policy: FAIL/WARN always email. For OK results:
ALWAYS_SEND=0                     # 1 = email every run
OK_REPORT_DOW=1                   # weekly OK heartbeat, ISO weekday (1=Mon)
LOG_FILE=/var/log/fms-cert-check.log
